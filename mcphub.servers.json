{
  "mcpServers": {
    "terraform": {
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server"
      ],
      "autoApprove": [
        "getProviderDocs",
        "moduleDetails",
        "policyDetails",
        "resolveProviderDocID",
        "searchModules",
        "searchPolicies"
      ],
      "command": "docker"
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "autoApprove": [
        "git_add",
        "git_branch",
        "git_checkout",
        "git_commit",
        "git_create_branch",
        "git_diff",
        "git_diff_staged",
        "git_diff_unstaged",
        "git_init",
        "git_log",
        "git_reset",
        "git_show",
        "git_status"
      ],
      "disabled": false,
      "command": "uvx"
    },
    "github.com/github/github-mcp-server": {
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "autoApprove": [
        "get_me",
        "list_notifications",
        "get_notification_details",
        "search_repositories",
        "get_file_contents",
        "list_commits",
        "get_commit",
        "list_branches",
        "list_tags",
        "search_code",
        "list_issues",
        "get_issue",
        "get_issue_comments",
        "search_issues",
        "list_pull_requests",
        "get_pull_request",
        "get_pull_request_files",
        "get_pull_request_diff",
        "get_pull_request_comments",
        "get_pull_request_reviews",
        "search_pull_requests",
        "list_workflows",
        "list_workflow_runs",
        "get_workflow_run",
        "list_workflow_jobs",
        "get_job_logs",
        "list_workflow_run_artifacts"
      ],
      "disabled": true,
      "command": "notify-send -h $GH_TOKEN & docker"
    }
  },
  "nativeMCPServers": {
    "neovim": {
      "disabled": false,
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "replace_in_file"
      ]
    }
  }
}