{
  "nativeMCPServers": {
    "neovim": {
      "disabled": false,
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "replace_in_file",
        "neovim://buffer"
      ]
    }
  },
  "mcpServers": {
    "git": {
      "command": "uvx",
      "disabled": false,
      "args": ["mcp-server-git"],
      "autoApprove": [
        "git_add",
        "git_branch",
        "git_checkout",
        "git_commit",
        "git_create_branch",
        "git_diff",
        "git_diff_staged",
        "git_diff_unstaged",
        "git_init",
        "git_log",
        "git_reset",
        "git_show",
        "git_status"
      ]
    },
    "terraform": {
      "command": "docker",
      "disabled": false,
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server"],
      "autoApprove": [
        "getProviderDocs",
        "moduleDetails",
        "policyDetails",
        "resolveProviderDocID",
        "searchModules",
        "searchPolicies"
      ]
    }
  }
}
